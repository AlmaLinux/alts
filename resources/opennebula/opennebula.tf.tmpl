variable "one_endpoint" {}
variable "one_username" {}
variable "one_password" {
  sensitive = true
}

provider "opennebula" {
  endpoint      = var.one_endpoint
  username      = var.one_username
  password      = var.one_password
}

data "opennebula_virtual_network" "test_system_network" {
  name = "${opennebula_network}"
}

data "opennebula_template" "selected_template" {
  id = ${template_id}
}

locals {
  # Extract NIC configuration from template first
  nic_0 = length(data.opennebula_template.selected_template.nic) > 0 ? data.opennebula_template.selected_template.nic[0] : null
  # Check if template has a network name defined
  template_network_name = try(local.nic_0.network, null)
  template_has_network = local.template_network_name != null
}

# Conditionally look up network from template if it has a network name
data "opennebula_virtual_network" "template_network" {
  count = local.template_has_network ? 1 : 0
  name  = local.template_network_name
}

locals {
  # Disk configuration
  disk_0 = data.opennebula_template.selected_template.disk[0]
  disk_size = max(
    local.disk_0.size,        # Original disk size from template
    15360,                    # Minimum required size
    local.disk_0.size + 5120  # Original size + 5GB
  )
  # Determine network_id: use template network if available, otherwise use test_system_network
  network_id = local.template_has_network ? data.opennebula_virtual_network.template_network[0].id : data.opennebula_virtual_network.test_system_network.id
}

resource "opennebula_virtual_machine" "${vm_name}" {
  name = "${vm_name}"
  template_id = ${template_id}
  permissions = "660"
  group = "${opennebula_vm_group}"
  memory = "${vm_ram_size}"
  hard_shutdown = true

  cpumodel {
    model = "host-passthrough"
  }
  disk {
    image_id = local.disk_0.image_id
    size = local.disk_size
    target = "sda"
  }
  nic {
    network_id = local.network_id
    model      = "virtio"
  }

  context = {
    NETWORK      = "YES"
    HOSTNAME     = "${vm_name}.test.com"
    SSH_PUBLIC_KEY = "$USER[SSH_PUBLIC_KEY]"
  }
}

output "vm_ip" {
  value = opennebula_virtual_machine.${vm_name}.ip
}

output "vm_id" {
  value = opennebula_virtual_machine.${vm_name}.id
}
